# Copy to .env and fill in your values
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ENTREZ_EMAIL=your_email@example.com

# Database (defaults work with docker-compose)
DATABASE_URL=postgresql://biometa:biometa_secret@localhost:5432/biometa_db
POSTGRES_USER=biometa
POSTGRES_PASSWORD=biometa_secret
POSTGRES_DB=biometa_db

# App settings
DEBUG=true
LOG_LEVEL=INFO
MAX_PUBMED_RESULTS=5000
